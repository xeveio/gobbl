#!/usr/bin/perl
# gobbl-agent: forwards Claude Code, Codex and Grok hook events to Gobbl.
#
#   Claude Code / Grok hook:  /usr/bin/perl gobbl-agent claude|grok   (event JSON on stdin)
#   Codex hook:               /usr/bin/perl gobbl-agent codex        (event JSON on stdin)
#   Legacy Codex notify:      /usr/bin/perl gobbl-agent codex JSON   (event JSON as the last argument)
#
# Sends "<source>\t<json>\n" to Gobbl's Unix socket. For a PermissionRequest
# it waits for Gobbl's reply (the user clicking Allow/Deny in the notch) and
# prints it for Claude Code or Codex. If Gobbl isn't running, or nobody answers
# in time, it prints nothing and exits 0, so the agent asks in the terminal.
# Part of Gobbl (MIT) — https://github.com/xeveio/gobbl
use strict;
use warnings;
use Socket;

my $source = shift @ARGV // 'claude';
# Grok also runs Claude Code's hook file. If our own Grok hook is installed,
# that copy will deliver the event — skip this Claude-compat one so Gob
# doesn't cheer twice.
my $from_grok = $ENV{GROK_SESSION_ID} || $ENV{GROK_HOOK_EVENT};
if ($from_grok && $source eq 'claude') {
    my $own = "$ENV{HOME}/.grok/hooks/gobbl.json";
    if (open my $fh, '<', $own) {
        local $/;
        my $t = <$fh> // '';
        close $fh;
        exit 0 if $t =~ /gobbl-agent/;
    }
}
$source = 'grok' if $from_grok;
my $payload = '';
if ($source eq 'codex' && @ARGV) {
    # Legacy Codex notify: the event JSON is the last argument.
    $payload = $ARGV[-1];
} else {
    # Hooks (Claude Code, Codex, Grok): the event JSON is on stdin.
    local $/;
    $payload = <STDIN> // '';
}
$payload =~ s/[\r\n]+/ /g;
exit 0 if $payload eq '';

my $path = "$ENV{HOME}/Library/Application Support/Gobbl/agent.sock";
socket(my $sock, PF_UNIX, SOCK_STREAM, 0) or exit 0;
connect($sock, sockaddr_un($path)) or exit 0;
select((select($sock), $| = 1)[0]);
print $sock "$source\t$payload\n";

if ($payload =~ /"hook_event_name"\s*:\s*"PermissionRequest"/) {
    my $reply = '';
    eval {
        local $SIG{ALRM} = sub { die "timeout\n" };
        alarm 40;
        $reply = <$sock> // '';
        alarm 0;
    };
    print $reply if $reply =~ /^\s*\{/;
}
close $sock;
exit 0;
